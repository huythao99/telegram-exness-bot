# 1. Thông tin API Telegram (lấy tại https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here
TG_SESSION_NAME=exness_copier_session

# 2. ID của Group/Channel cần nghe lệnh (chạy `python3 list_chats.py` để lấy ID)
# Có thể điền nhiều ID cách nhau bởi dấu phẩy, VD: -100123456789,-100987654321
TARGET_CHAT_IDS=-1001234567890

# 3. Exness Trader API (tạo key tại Personal Area -> Key Management, xem https://www.exness-api.com)
EXN_API_KEY=exnsk_your_public_api_key
# Private key Ed25519: dùng 1 trong 2 cách
#   - Đường dẫn file PEM (openssl genpkey -algorithm ED25519 -out exness_key.pem)
EXN_PRIVATE_KEY_PATH=~/.exness/exness_key.pem
#   - Hoặc dán thẳng chuỗi hex 128 ký tự do Exness tạo
EXN_PRIVATE_KEY=
EXN_ACCOUNT_ID=123456789
# Gateway host lấy từ widget DNS trong Key Management (dùng để tự tìm Access Point)
EXN_DISCOVERY_BASE_URL=https://your-gateway-host.exness.com
# Để trống để bot tự tìm Access Point qua Gateway
EXN_API_BASE_URL=

# true = chỉ in lệnh ra màn hình (an toàn để thử). Đổi thành false để đặt lệnh thật.
DRY_RUN=true

# 4. Cấu hình giao dịch Vàng
SYMBOL=XAUUSDm
# Comment gắn vào lệnh để bot nhận ra lệnh của mình
ORDER_TAG=TGBOT
LOT_PER_ORDER=0.01

# SL cố định 10 giá và TP cố định 10 giá cho mỗi lệnh (tính từ giá vào lệnh)
FIXED_SL_PRICE_DISTANCE=10.0
FIXED_TP_PRICE_DISTANCE=10.0

# Nếu giá hiện tại đã chạm/vượt điểm vào (trong biên này) -> vào Market ngay, ngược lại đặt lệnh chờ
MARKET_TOLERANCE=0.30
SLIPPAGE_POINTS=50

# Khi có tin nhắn báo lãi Vàng +(x)pip (x >= 1) -> Chốt 50% số lệnh + Dời SL lệnh còn lại
PARTIAL_PROFIT_PIPS=1
PARTIAL_CLOSE_RATIO=0.5
CANCEL_PENDING_ON_BE=true
