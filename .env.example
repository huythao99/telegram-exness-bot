# 1. Thông tin API Telegram (lấy tại https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here
TG_SESSION_NAME=exness_copier_session

# 2. ID của Group/Channel cần nghe lệnh (chạy `python3 list_chats.py` để lấy ID)
# Có thể điền nhiều ID cách nhau bởi dấu phẩy, VD: -100123456789,-100987654321
TARGET_CHAT_IDS=-1001234567890

# 3. Đường dẫn thư mục MQL5/Files của MT5 trên máy Mac
# Mở MT5 -> File -> Open Data Folder -> vào MQL5/Files -> Copy đường dẫn dán vào đây
MT5_FILES_DIR=/Users/your_mac_username/Library/Application Support/net.metaquotes.wine.metatrader5/drive_c/Program Files/MetaTrader 5/MQL5/Files

# 4. Cấu hình giao dịch Vàng (XAUUSD)
GRID_COUNT=10
LOT_PER_ORDER=0.01

# SL cố định 10 giá (100 pips) và TP cố định 10 giá (100 pips) cho tất cả các lệnh
FIXED_SL_PRICE_DISTANCE=10.0
FIXED_TP_PRICE_DISTANCE=10.0

# Khi có tin nhắn báo lãi Vàng +(x)pip (x >= 1) -> Chốt 50% số lệnh + Dời SL các lệnh còn lại
PARTIAL_PROFIT_PIPS=1
PARTIAL_CLOSE_RATIO=0.5
